{
  "name": "omni-qrono-count-wise",
  "version": "0.0.6",
  "scripts": {
    "ng": "ng",
    "install-deps": "npm i",
    "clean-install": "npm cache clean --force && npm i",
    "reset-install": "if exist node_modules rmdir /s /q node_modules && if exist package-lock.json del package-lock.json && npm i",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "engines": {
    "node": ">=18.13.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "21.2.0",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/material": "21.2.0",
    "@angular/platform-browser": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@angular/service-worker": "^21.2.17",
    "bootstrap": "5.3.3",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "rxjs": "7.8.0",
    "sass": "1.87.0",
    "tslib": "2.8.0",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.16",
    "@angular/cli": "21.2.5",
    "@angular/compiler-cli": "21.2.17",
    "@angular/localize": "^21.2.17",
    "@types/node": "22.19.13",
    "@types/qrcode": "1.5.6",
    "angular-cli-ghpages": "3.0.2",
    "typescript": "~5.9.3"
  }
}
